# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Credentials (mendukung prefix VITE_ maupun tanpa prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Jembatan Siaran Antar-Aplikasi (Cross-App Broadcast Bridge ke Database Supabase ke-2)
VITE_SHARED_BROADCAST_SUPABASE_URL=
VITE_SHARED_BROADCAST_SUPABASE_ANON_KEY=
SHARED_BROADCAST_SUPABASE_URL=
SHARED_BROADCAST_SUPABASE_ANON_KEY=

# Google Sheets / Cloudflare Worker Webhook Sync (Otomatis untuk semua perangkat)
VITE_GSHEET_WEBHOOK_URL=
VITE_GSHEET_SPREADSHEET_ID=
VITE_GSHEET_SHEET_NAME=Incoming
